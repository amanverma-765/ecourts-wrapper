{
  "name": "ecourts-api-wrapper",
  "type": "module",
  "scripts": {
    "generate": "NODE_NO_WARNINGS=1 buf generate",
    "typecheck": "tsc --noEmit",
    "dev": "pnpm typecheck && wrangler dev",
    "deploy": "pnpm typecheck && wrangler deploy --minify",
    "cf-typegen": "pnpm typecheck && wrangler types --env-interface CloudflareBindings"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@bufbuild/buf"]
  },
  "peerDependencies": {
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.66.0",
    "@bufbuild/protoc-gen-es": "^2.11.0",
    "@eslint/js": "^9.33.0",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "jiti": "^2.5.1",
    "typescript-eslint": "^8.39.1",
    "wrangler": "^4.4.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@connectrpc/connect": "^2.1.1",
    "neverthrow": "^8.2.0",
    "zod": "^4.0.17"
  }
}
